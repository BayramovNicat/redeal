# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/re_agregator?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Google OAuth & Authentication
AUTH_ENABLED=true
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Required in production (NODE_ENV=production)
AUTH_SESSION_SECRET="change-this-to-a-random-32-byte-hex-or-base64-secret"
AUTH_SESSION_TTL_SECONDS=2592000

# Scrape Admin (optional standalone password login for /api/scrape/run)
SCRAPE_ADMIN_PASSWORD=""
SCRAPE_ADMIN_SESSION_SECRET=""
SCRAPE_ADMIN_SESSION_TTL_SECONDS=28800

# Telegram Bot & Alerts (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
