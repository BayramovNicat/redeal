generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScrapeRunTrigger {
  manual
  cron
}

enum ScrapeRunStatus {
  running
  success
  failed
  skipped
}

enum PropertyCategory {
  new
  old
  house
}

enum ListingType {
  sale
  rent
}

model Property {
  id                  Int               @id @default(autoincrement())
  source_url          String            @unique
  price               Decimal           @db.Decimal(12, 2)
  area_sqm            Decimal           @db.Decimal(8, 2)
  price_per_sqm       Decimal           @db.Decimal(10, 2)
  district            String
  location_name       String?
  latitude            Float?
  longitude           Float?
  rooms               Int?
  floor               Int?
  total_floors        Int?
  category            PropertyCategory?
  listing_type        ListingType        @default(sale)
  has_document        Boolean?
  has_mortgage        Boolean?
  has_repair          Boolean?
  description         String?
  image_urls          String[]
  is_urgent           Boolean           @default(false)
  has_active_mortgage Boolean           @default(false)
  price_drop_count    Int               @default(0)
  posted_date         DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  price_history PriceHistory[]

  @@index([district])
  @@index([location_name])
  @@index([is_urgent])
  @@index([has_active_mortgage])
  @@index([price_drop_count])
  @@index([listing_type])
  @@index([price_per_sqm])
  @@index([location_name, price_per_sqm])
  @@index([location_name, is_urgent, posted_date])
  @@index([district, price_per_sqm])
  @@index([location_name, district, posted_date])
}

model PriceHistory {
  id            Int      @id @default(autoincrement())
  property_id   Int
  price         Decimal  @db.Decimal(12, 2)
  price_per_sqm Decimal  @db.Decimal(10, 2)
  recorded_at   DateTime @default(now())

  property Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@index([property_id])
  @@index([property_id, recorded_at])
}

model Alert {
  id          String   @id @default(uuid())
  chat_id     String
  label       String?
  filters     Json
  last_run_at DateTime @default(now())
  created_at  DateTime @default(now())
  token       String   @unique @default(uuid())
  is_active   Boolean  @default(true)

  @@index([is_active])
  @@index([chat_id])
}

model ScrapeRun {
  id               String           @id @default(uuid())
  trigger          ScrapeRunTrigger
  status           ScrapeRunStatus
  started_at       DateTime         @default(now())
  finished_at      DateTime?
  duration_ms      Int?
  options          Json?
  platform_results Json?
  total_fetched    Int              @default(0)
  total_persisted  Int              @default(0)
  total_skipped    Int              @default(0)
  total_errors     Int              @default(0)
  error_message    String?

  @@index([started_at])
  @@index([status, started_at])
  @@index([trigger, started_at])
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  name       String?
  avatar     String?
  google_id  String?   @unique
  role       String    @default("user")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  sessions   Session[]

  @@index([email])
}

model WhitelistedEmail {
  id         String   @id @default(uuid())
  email      String   @unique
  note       String?
  created_at DateTime @default(now())

  @@index([email])
}

model Session {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
}
